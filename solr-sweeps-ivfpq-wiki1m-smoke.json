{
  "wiki1m": {
    "dataset": "wiki-10m",
    "common-params": {
      "numDocs": 1000000,
      "numQueriesToRun": 50,
      "numWarmUpQueries": 5,
      "batchSize": 50000,
      "topK": 100,
      "efSearch": [800],
      "vectorColName": "article_vector",
      "cleanIndexDirectory": true
    },
    "algorithms": {
      "cagra_hnsw": {
        "cuvsWriterThreads": 8,
